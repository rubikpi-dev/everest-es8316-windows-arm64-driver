#include <windows.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 252, 218
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Codec settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "&Setting:", -1, 7, 7, 160, 8
    LISTBOX IDC_SETTINGS, 7, 18, 238, 62, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Value:", -1, 7, 86, 30, 8
    EDITTEXT IDC_VALUE, 42, 83, 203, 14, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX IDC_CHOICE, 42, 83, 203, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_DEFAULT_TEXT, 7, 102, 171, 18
    PUSHBUTTON "Restore &default", IDC_DEFAULT, 181, 101, 64, 14
    LTEXT "", IDC_HELP_TEXT, 7, 124, 238, 51
    LTEXT "Apply saves settings and requests a codec restart. Stop playback and recording first. Restart Windows if changes do not take effect.", -1, 7, 179, 238, 25
    LTEXT "", IDC_ACCESS, 7, 205, 238, 10
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,8,0
 PRODUCTVERSION 1,0,8,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rubik Pi 3 WoA Project"
            VALUE "FileDescription", "ES8316 Device Manager codec settings"
            VALUE "FileVersion", "1.0.8.0"
            VALUE "InternalName", "ES8316Prop"
            VALUE "OriginalFilename", "ES8316Prop.dll"
            VALUE "ProductName", "Everest ES8316 Audio Codec"
            VALUE "ProductVersion", "1.0.8.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
